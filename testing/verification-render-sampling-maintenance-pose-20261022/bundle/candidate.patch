new file mode 100644
index 0000000..2bffb68
--- /dev/null
+++ b/frontend/design-client/src/kernel/pose-feedback.test.mjs
@@ -0,0 +1,18 @@
+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { PoseFeedback } from './pose-feedback.ts'
+test('submitted input cannot move feedback before the matching accepted pose',()=>{
+ const p=new PoseFeedback();p.submit(1,{x:4,y:0});p.submit(2,{x:12,y:0})
+ assert.equal(p.present(3),undefined);assert.deepEqual(p.present(1),{x:4,y:0});assert.equal(p.present(1),undefined)
+ assert.deepEqual(p.present(2),{x:12,y:0});assert.equal(p.present(1),undefined)
+})
+test('coalescing, reset and bounded records reject missing/stale completions',()=>{
+ const p=new PoseFeedback();for(let i=1;i<=300;i++)p.submit(i,{x:i,y:-i})
+ assert.equal(p.present(1),undefined);assert.deepEqual(p.present(299),{x:299,y:-299});p.clear();assert.equal(p.present(300),undefined)
+ p.submit(301,{x:0,y:0});assert.deepEqual(p.present(301),{x:0,y:0})
+})
+
+test('opaque submission ownership cannot be relabeled by the accepting document',()=>{
+ const p=new PoseFeedback(),a={},b={};p.submit(1,{x:5,y:9},a)
+ assert.equal(p.present(1,b),undefined);assert.deepEqual(p.present(1,a),{x:5,y:9})
+})
diff --git a/frontend/design-client/src/kernel/pose-feedback.ts b/frontend/design-client/src/kernel/pose-feedback.ts
new file mode 100644
index 0000000..db6085e
--- /dev/null
+++ b/frontend/design-client/src/kernel/pose-feedback.ts
@@ -0,0 +1,20 @@
+/** A submitted pose is not a displayed pose. Retain only small offsets, never
+ * document snapshots or geometry; acknowledgement ownership is checked by the
+ * resident presenter before it enters this ledger. */
+export class PoseFeedback {
+  private pending = new Map<number, { offset: { x: number; y: number }; owner?: object }>()
+  private accepted = 0
+  submit(sequence: number, offset: { x: number; y: number }, owner?: object) {
+    this.pending.set(sequence, { offset: { ...offset }, owner })
+    while (this.pending.size > 180) this.pending.delete(this.pending.keys().next().value!)
+  }
+  present(sequence: number, owner?: object) {
+    if (!Number.isSafeInteger(sequence) || sequence <= this.accepted) return undefined
+    const record = this.pending.get(sequence)
+    if (!record || record.owner !== owner) return undefined
+    this.accepted = sequence
+    for (const key of this.pending.keys()) if (key <= sequence) this.pending.delete(key)
+    return record.offset
+  }
+  clear() { this.pending.clear(); this.accepted = 0 }
+}
