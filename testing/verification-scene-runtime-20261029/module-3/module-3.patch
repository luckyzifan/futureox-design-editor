+    let mut runtime = Runtime::default();
+    compare(
+        &mut runtime,
+        &mut actual,
+        &mut expected,
+        &desc,
+        &request(-480.25, -480.375, 1.),
+    );
+    assert_eq!(runtime.stats["mode"], "demand");
+    for (id, node) in &runtime
+        .compiler
+        .as_ref()
+        .unwrap()
+        .doc
+        .as_ref()
