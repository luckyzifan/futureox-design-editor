+import { afterEach, expect, test, vi } from 'vitest'
+import { CompleteFilterCache, COMPLETE_FILTER_CACHE_BYTES } from './complete-filter-cache'
+import { GpuRenderer, type Surface } from './renderer'
+import type { Driver, GpuNode, GpuScene, PathMesh, Rect, Texture } from './types'
+
+afterEach(() => vi.unstubAllEnvs())
+const plane = (rect: Rect = { x: 0, y: 0, w: 8, h: 8 }): Surface => ({ rect,
+  texture: { width: rect.w, height: rect.h, bytes: rect.w * rect.h * 16, resource: {} } as Texture })
+const input = { x: -4, y: -4, w: 24, h: 16 }
+test('only successful finish publishes immutable planes across request boundaries', () => {
+  const released: Surface[] = [], cache = new CompleteFilterCache(p => released.push(p)), image = plane().texture, value = plane()
+  expect(cache.stage('key', image, value, input, 4)).toBe(true)
+  expect(cache.get('key', image, value.rect, input, 4)).toBeUndefined()
+  cache.finish(true); cache.begin()
+  expect(cache.get('key', image, value.rect, input, 4)?.[0].plane.texture).toBe(value.texture)
+  expect(cache.get('key', plane().texture, value.rect, input, 4)).toBeUndefined()
+  expect(cache.get('changed', image, value.rect, input, 4)).toBeUndefined()
+  cache.clear(); cache.clear()
+  expect(released.map(p => p.texture)).toEqual([value.texture])
+})
+test('multiple regional planes cover a request completely without overlapping output copies', () => {
+  const cache = new CompleteFilterCache(() => {}), image = plane().texture
+  for (const x of [0, 8]) { cache.stage('key', image, plane({ x, y: 0, w: 8, h: 8 }), input, 4); cache.finish(true) }
+  const output = { x: 2, y: 1, w: 12, h: 6 }, copies = cache.get('key', image, output, input, 4)!
+  expect(copies).toHaveLength(2)
+  expect(copies.reduce((area, copy) => area + copy.region.w * copy.region.h, 0)).toBe(72)
+  expect(cache.get('key', image, { ...output, w: 16 }, input, 4)).toBeUndefined()
+})
+test('different input crops exclude zero-padded edges even if the stored output overlaps', () => {
+  const cache = new CompleteFilterCache(() => {}), image = plane().texture, original = { x: 0, y: 0, w: 12, h: 12 }
+  cache.stage('key', image, plane(original), original, 3); cache.finish(true)
+  expect(cache.get('key', image, original, original, 3)).toBeDefined()
+  const shifted = { x: 1, y: 1, w: 12, h: 12 }
+  expect(cache.get('key', image, { x: 4, y: 4, w: 5, h: 5 }, shifted, 3)).toBeDefined()
+  expect(cache.get('key', image, { x: 3, y: 4, w: 6, h: 5 }, shifted, 3)).toBeUndefined()
+  expect(cache.get('key', image, { x: 4, y: 4, w: 6, h: 5 }, shifted, 3)).toBeUndefined()
+  expect(cache.get('key', image, { x: 4.5, y: 4, w: 4, h: 5 }, shifted, 3)).toBeUndefined()
+})
+test('pending and completed storage share a 64 MiB ceiling and failure retires ownership once', () => {
+  const released: Texture[] = [], cache = new CompleteFilterCache(p => released.push(p.texture)), image = plane().texture
+  const large = plane({ x: 0, y: 0, w: 2048, h: 2048 }), small = plane()
+  expect(large.texture.bytes).toBe(COMPLETE_FILTER_CACHE_BYTES)
+  expect(cache.stage('large', image, large, large.rect, 1)).toBe(true); cache.finish(true)
+  expect(cache.stage('small', image, small, input, 4)).toBe(true)
+  expect(released).toEqual([large.texture]); expect(cache.bytes).toBe(small.texture.bytes)
+  cache.finish(false); cache.clear()
+  expect(released).toEqual([large.texture, small.texture]); expect(cache.bytes).toBe(0)
+  const tooLarge = plane({ x: 0, y: 0, w: 2049, h: 2048 })
+  expect(cache.stage('large', image, tooLarge, tooLarge.rect, 1)).toBe(false)
+  const bytePlane = plane(); bytePlane.texture.bytes /= 4
+  expect(cache.stage('bytes', image, bytePlane, input, 4)).toBe(false)
+})
+test('a camera or precision context change retires completed and pending regions before new work', () => {
+  const released: Texture[] = [], cache = new CompleteFilterCache(p => released.push(p.texture)), image = plane().texture
+  const a = plane(), b = plane()
+  cache.begin('camera-1/exact'); cache.stage('node', image, a, input, 4); cache.finish(true)
+  cache.begin('camera-1/exact')
+  expect(cache.get('node', image, a.rect, input, 4)).toBeDefined()
+  cache.stage('pending', image, b, input, 4)
+  cache.begin('camera-32/exact')
+  expect(released).toEqual([a.texture, b.texture]); expect(cache.bytes).toBe(0)
+  const c = plane(); cache.stage('node', image, c, input, 4); cache.finish(true)
+  cache.begin('camera-32/display-math')
+  expect(cache.get('node', image, c.rect, input, 4)).toBeUndefined()
+  expect(released).toEqual([a.texture, b.texture, c.texture])
+})
+
+function coverage(rect: Rect) {
+  const header = 1 + rect.h * 4, curves = new Float32Array((header + rect.h * 4 * 3) * 4)
+  curves.set([3, 1, rect.w, rect.h])
+  for (let row = 0; row < rect.h * 4; row++) {
+    curves.set([header + row * 3, 1, 0, 0], 4 + row * 4)
+    curves.set([0, rect.w, 0, 0], (header + row * 3) * 4)
+  }
+  return { curves, path: { rect, count: 3, first: 0, rule: 'nonzero', sampleCount: 4,
+    area: { first: 0, count: curves.length / 4 } } as PathMesh }
+}
+/** Real production stream/cache orchestration, with a CPU command transport
+ * and independent finite sample/filter arithmetic. This is not a GPU oracle. */
+function streamFixture() {
+  vi.stubEnv('VITE_DESIGN_COMPLETE_FILTER_CACHE', '1')
+  vi.stubEnv('VITE_DESIGN_PREFIX_ALIGNED_STRIPS', '0')
+  vi.stubEnv('VITE_DESIGN_HORIZONTAL_FILTER_REUSE', '0')
+  const pixels = new Map<Texture, Float32Array>(), copies: Rect[] = []
+  let sampleCalls = 0
+  const create = (w: number, h: number) => { const t = plane({ x: 0, y: 0, w, h }).texture; pixels.set(t, new Float32Array(w * h * 4)); return t }
+  const copy = (target: Texture, source: Texture, r: Rect, origin: [number, number]) => {
+    const a = new Uint32Array(pixels.get(source)!.buffer), b = new Uint32Array(pixels.get(target)!.buffer)
+    for (let y = 0; y < r.h; y++) for (let x = 0; x < r.w; x++) for (let c = 0; c < 4; c++)
