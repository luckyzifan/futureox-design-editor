+import { exactBlendLattice } from './effect-region'
+import { intersect, type Rect, type Texture } from './types'
+
+export const COMPLETE_FILTER_CACHE_BYTES = 64 * 1024 * 1024
+const MAX_ENTRIES = 16
+type Plane = { texture: Texture; rect: Rect }
+type Entry = { key: string; image: Texture; plane: Plane; input: Rect; valid: Rect; support: number }
+export type CompleteFilterCopy = { plane: Plane; region: Rect }
+const sameRect = (a: Rect, b: Rect) => a.x === b.x && a.y === b.y && a.w === b.w && a.h === b.h
+const inset = (r: Rect, support: number): Rect => ({ x: r.x + support, y: r.y + support,
+  w: Math.max(0, r.w - support * 2), h: Math.max(0, r.h - support * 2) })
+function subtract(r: Rect, cut: Rect): Rect[] {
+  return [
+    { x: r.x, y: r.y, w: r.w, h: cut.y - r.y },
+    { x: r.x, y: cut.y + cut.h, w: r.w, h: r.y + r.h - cut.y - cut.h },
+    { x: r.x, y: cut.y, w: cut.x - r.x, h: cut.h },
+    { x: cut.x + cut.w, y: cut.y, w: r.x + r.w - cut.x - cut.w, h: cut.h },
+  ].filter(part => part.w > 0 && part.h > 0)
+}
+
+/** Completed, pre-opacity RGBA32F filter results. The renderer proves an
+ * identical immutable image mapping and four fully covered source samples.
+ * Different crops may share only pixels with complete neighborhoods in both;
+ * identical input rectangles may also share their identical zero-padded edge.
+ * Releases return to the renderer's queue-ordered pool, never destroy textures. */
+export class CompleteFilterCache {
+  private entries: Entry[] = []
+  private pending: Entry[] = []
+  private context?: string
+  constructor(private release: (plane: Plane) => void) {}
+  get bytes() { return [...this.entries, ...this.pending].reduce((sum, entry) => sum + entry.plane.texture.bytes, 0) }
+  get count() { return this.entries.length }
+  has(texture: Texture) { return [...this.entries, ...this.pending].some(entry => entry.plane.texture === texture) }
+  begin(context?: string) {
+    // Camera/precision changes make all previous node keys impossible hits.
+    // Retire them before the new frame allocates its horizontal filter work.
+    if (this.context !== context) { this.clear(); this.context = context }
+    for (const entry of this.pending.splice(0)) this.release(entry.plane)
+  }
+  get(key: string, image: Texture, output: Rect, input: Rect, support: number): CompleteFilterCopy[] | undefined {
+    if (!Number.isSafeInteger(support) || support < 0 || !exactBlendLattice([input, output]) ||
+        input.w <= 0 || input.h <= 0 || output.w <= 0 || output.h <= 0 || !sameRect(intersect(input, output), output)) return
+    let missing = [output]
+    const copies: CompleteFilterCopy[] = [], used: Entry[] = []
+    for (const entry of [...this.entries].reverse()) {
+      if (entry.key !== key || entry.image !== image || entry.support !== support) continue
+      const valid = sameRect(entry.input, input) ? entry.plane.rect : intersect(entry.valid, inset(input, support))
+      const rest: Rect[] = []
+      const before = copies.length
+      for (const region of missing) {
+        const overlap = intersect(region, valid)
+        if (!overlap.w || !overlap.h) { rest.push(region); continue }
+        copies.push({ plane: entry.plane, region: overlap })
+        rest.push(...subtract(region, overlap))
+      }
+      if (copies.length > before) used.push(entry)
+      if (copies.length > 64) return
+      missing = rest
+      if (!missing.length) {
+        this.entries = [...this.entries.filter(candidate => !used.includes(candidate)), ...used]
+        return copies
+      }
+      if (missing.length > 64) return
+    }
+  }
+  stage(key: string, image: Texture, plane: Plane, input: Rect, support: number): boolean {
+    if (!Number.isSafeInteger(support) || support < 0 || !exactBlendLattice([plane.rect, input]) ||
+        input.w <= 0 || input.h <= 0 || plane.rect.w <= 0 || plane.rect.h <= 0 ||
+        !sameRect(intersect(input, plane.rect), plane.rect) ||
+        plane.texture.width !== plane.rect.w || plane.texture.height !== plane.rect.h ||
+        plane.texture.bytes !== plane.rect.w * plane.rect.h * 16 || plane.texture.bytes > COMPLETE_FILTER_CACHE_BYTES ||
+        this.has(plane.texture)) return false
+    while (this.bytes + plane.texture.bytes > COMPLETE_FILTER_CACHE_BYTES || this.entries.length + this.pending.length >= MAX_ENTRIES) {
+      const old = this.entries.shift() || this.pending.shift()
+      if (!old) return false
+      this.release(old.plane)
+    }
+    this.pending.push({ key, image, plane: { texture: plane.texture, rect: { ...plane.rect } }, input: { ...input },
+      valid: intersect(plane.rect, inset(input, support)), support })
+    return true
+  }
+  finish(success: boolean) {
+    if (!success) { this.clear(); return }
+    this.entries.push(...this.pending.splice(0))
+  }
+  clear() { for (const entry of [...this.entries.splice(0), ...this.pending.splice(0)]) this.release(entry.plane) }
+}
