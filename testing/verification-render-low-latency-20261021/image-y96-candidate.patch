+function sourceFunction(name: string, source = exactImageXTableMathWgsl) {
+  const start = source.indexOf(`fn ${name}(`), open = source.indexOf('{', start)
+  if (start < 0 || open < 0) throw Error(`Missing production function ${name}`)
+  let end = open + 1, depth = 1
+  for (; depth && end < source.length; end++) {
+    if (source[end] === '{') depth++
+    if (source[end] === '}') depth--
+  }
+  if (depth) throw Error('Unclosed production function')
+  const signature = source.slice(start, open)
+  const args = signature.slice(signature.indexOf('(') + 1, signature.indexOf(')')).split(',').map(a => a.split(':')[0].trim()).join(',')
+  const body = source.slice(open + 1, end - 1)
+    .replace(/\bvar\b/g, 'let').replace(/\b(0x[0-9a-f]+|\d+)u\b/gi, '$1')
+    .replace(/vec([34])<u32>/g, 'vec$1u')
+    .replace(/\b(\w+)\.([xyzw])\b/g, (_m, name, axis) => `${name}[${'xyzw'.indexOf(axis)}]`)
+    .replace(/>>/g, '>>>').replace('a[2]*factor', 'Math.imul(a[2],factor)')
+    // Model inferred-u32 scalar declarations with their actual wrap semantics.
+    .replace(/let (low|middle|carried|high|offset)=([^;]+);/g, 'let $1=u32($2);')
+  return `function ${name}(${args}){${body}}`
