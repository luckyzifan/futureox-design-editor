+function helpers(enabled: boolean): Helpers {
+  const names = ['xiAdd96', 'xiNeg96', 'xiSub96', 'xiShift96', 'xiTimesWord96', 'xiY96']
+  const vector = (count: number, args: (number | Vec)[]) => {
+    const parts = args.flat(); return (parts.length === 1 ? Array(count).fill(parts[0]) : parts).map(v => v >>> 0)
