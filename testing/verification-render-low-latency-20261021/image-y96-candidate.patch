+type Vec = number[]
+const mask96 = (1n << 96n) - 1n, sign96 = 1n << 95n
+const mask128 = (1n << 128n) - 1n
+function packed(n: bigint, length = 3): Vec {
+  return Array.from({ length }, (_, i) => Number(n >> BigInt(i * 32) & 0xffffffffn))
+}
+function unsigned(v: Vec): bigint { return v.reduce((n, w, i) => n | BigInt(w >>> 0) << BigInt(i * 32), 0n) }
