+/** Geometry complexity belongs to this exact prepared region. Share only
+ * allocation-pressure learning with neighbouring regions of the same policy. */
+export class PreviewRegionAdmission extends PreviewAdmission {
+  constructor(private readonly allocations: PreviewAdmission) { super() }
+  override shouldSplit(tile: PreviewTile) {
+    return super.shouldSplit(tile) || this.allocations.shouldSplit(tile)
+  }
+  override observe(error: unknown, tile: PreviewTile) {
+    if(isAnalyticProgramBudget(error)||isScenePathBudget(error))super.observe(error,tile)
+    else this.allocations.observe(error,tile)
   }
 }
 
