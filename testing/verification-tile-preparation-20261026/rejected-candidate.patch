+use super::*;
+use serde_json::json;
+
+#[test]
+fn final_tile_admission_failure_preserves_completed_programs_and_local_invalidation() {
+    let mut nodes=serde_json::Map::new();let mut ids=Vec::new();
+    for i in 0..100 {
+        let id=format!("r{i:03}");let angle=(i as f64+1.)*0.0001;
+        nodes.insert(id.clone(),json!({"id":id,"kind":"rectangle","width":512,"height":512,
+            "transform":[angle.cos(),angle.sin(),-angle.sin(),angle.cos(),30.,20.],
+            "fills":[{"kind":"solid","color":"#123456"}]}));ids.push(id);
+    }
+    let mut document=json!({"schemaVersion":3,"id":"d","name":"d",
+        "colorManagement":crate::color::ColorSettings::default(),
+        "pages":[{"id":"p","name":"p","background":"#ffffff","children":ids}],"nodes":nodes});
+    let mut engine=Engine::new();engine.load_document(&document.to_string()).unwrap();
+    let options:RenderOptions=serde_json::from_value(json!({"pageId":"p","width":514,"height":514,
+        "view":{"x":0.25,"y":0.5,"zoom":1},"rasterProfile":"figmaSubpixel"})).unwrap();
+    let guard=Rect::new(0,0,600,600);let half=Rect::new(0,0,514,257);
+    let expected=engine.compile_gpu_region(&options,half,Some(guard)).unwrap().into_packet().unwrap();
+    let key=engine.camera_prepare.as_ref().unwrap().programs.entries["r000"].keys().next().unwrap().clone();
+    let prior=engine.camera_prepare.as_mut().unwrap().programs.get("r000",&key).unwrap();
+    for _ in 0..2 {
+        assert_eq!(engine.compile_gpu_region(&options,Rect::new(0,0,514,514),Some(guard)).err().unwrap(),
+            "GPU analytic interval program budget exceeded");
+        let cache=engine.camera_prepare.as_mut().unwrap();
+        let retained=cache.programs.get("r000",&key).expect("failed crop discarded completed shared preparation");
+        assert!(Arc::ptr_eq(&prior,&retained));
+        assert!(cache.programs.bytes+cache.fragments.bytes<=ProgramCache::LIMIT);
+    }
+    assert_eq!(expected,engine.compile_gpu_region(&options,half,Some(guard)).unwrap().into_packet().unwrap());
+    let transform=Transform([1.,0.,0.,1.,32.25,22.5]);
+    assert!(engine.apply_interaction_transforms(&BTreeMap::from([("r050".into(),transform)])).unwrap());
+    assert!(!engine.camera_prepare.as_ref().unwrap().programs.entries.contains_key("r050"));
+    assert!(Arc::ptr_eq(&prior,&engine.camera_prepare.as_mut().unwrap().programs.get("r000",&key).unwrap()));
+    document["nodes"]["r050"]["transform"]=json!(transform.0);
+    let mut fresh=Engine::new();fresh.load_document(&document.to_string()).unwrap();
+    for crop in [half,Rect::new(0,257,514,257)] {
+        let actual=engine.compile_gpu_region(&options,crop,Some(guard)).unwrap();
+        let reference=fresh.compile_gpu_region(&options,crop,None).unwrap();
+        assert_eq!(serde_json::to_value(actual).unwrap(),serde_json::to_value(reference).unwrap());
+    }
+}
