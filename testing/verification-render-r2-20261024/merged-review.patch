+        }
+        self.bytes = next_bytes.unwrap();
+        self.keys = next_keys.unwrap();
+        Ok(())
+    }
+    fn release(&mut self, bytes: usize, keys: usize) -> io::Result<()> {
+        self.bytes = self
+            .bytes
+            .checked_sub(bytes)
+            .ok_or_else(|| invalid("Invalid JSON fragment key accounting"))?;
+        self.keys = self
+            .keys
+            .checked_sub(keys)
+            .ok_or_else(|| invalid("Invalid JSON fragment key accounting"))?;
+        Ok(())
+    }
