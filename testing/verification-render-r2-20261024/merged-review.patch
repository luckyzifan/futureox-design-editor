+        fs::create_dir(&root).unwrap();
+        let source = root.join("source.json");
+        fs::write(&source, SOURCE).unwrap();
+        let sessions = Sessions::new(root.join("cache"));
+        let status = sessions
+            .open(
+                Open {
+                    path: source.clone(),
+                    document_id: "checkpoint-test".into(),
+                    session_epoch: 1,
