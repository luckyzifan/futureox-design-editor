+    node.radii = [0.; 4];
+    node.smoothing = 0.;
+    node.clip = kind == "frame";
+    node.points = if kind == "star" { 5 } else { 3 };
+    if matches!(kind, "slice" | "group") {
+        node.fills.clear();
+    } else if kind == "frame" {
+        node.fills[0].color = "#ffffff".into();
+        node.fills[0].stops[0].color = "#ffffff".into();
+    } else if kind == "section" {
