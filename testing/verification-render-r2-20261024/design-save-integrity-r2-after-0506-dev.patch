+            add_new_source_node(&mut document, OTHER, ui_new_source_node(NEW_SIBLING, "ellipse"));
+            add_new_source_node(&mut document, OTHER, bad);
+        } else {
+            add_new_source_node(&mut document, OTHER, ui_new_source_node(NEW_PARENT, "group"));
