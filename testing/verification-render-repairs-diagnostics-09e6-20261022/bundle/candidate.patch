+    if(stage===1&&this.closed){this.gesture++;this.closed=false;this.emitted=0;this.last=-Infinity;this.seen.clear();this.pending.clear();this.evictedOldest=undefined;this.evictedThrough=0;this.submitted=this.sampled=this.acknowledged=this.accepted=this.rejected=this.evicted=0}
