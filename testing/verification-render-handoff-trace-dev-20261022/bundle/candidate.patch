+ expect(f.uploaded).toHaveLength(3);expect(f.r.retiredUploads).toHaveLength(3)
+ expect(f.driver.destroy).not.toHaveBeenCalled();expect(f.r.materialFields.bytes).toBe(0)
+ expect(f.r.sequentialImagePins.size).toBe(0)
+})
