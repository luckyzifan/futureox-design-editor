+          if (this.deferred + added.length >= 8) return 5
+          added.push(resource)
+        }
+      }
+      for (const resource of added) this.retained.add(resource)
+      this.deferred += added.length
+      return 0
+    }
     if (this.deferred >= 8) return 5
     this.deferred++
     return 0
   }
