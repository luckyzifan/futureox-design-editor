# Keep reproducible tools, source identities and sampled CPU analyses.
# Raw host state, document screenshots and other local captures stay on disk.
*
!.gitignore
!README.md
!*.mjs
!run-summary.json
!identity-check.json
!wasm-symbol-identity.json
!wasm-names.json
!index.html
!117-run1/
!fig-run1/
!fig-text-run2/
!117-run1/*.svg
!117-run1/flamegraphs.html
!117-run1/cpu-summary.json
!117-run1/diag-summary.json
!fig-run1/*.svg
!fig-run1/flamegraphs.html
!fig-run1/cpu-summary.json
!fig-text-run2/*.svg
!fig-text-run2/flamegraphs.html
!fig-text-run2/cpu-summary.json
