+        (ELLIPSE, "arc", json!({"startAngle":0.25,"sweepAngle":1.5,"innerRadius":0.25})),
+        (POLYGON, "cornerRadius", json!(4.)),
+        (RECT, "exportSettings", json!([{"id":"sketch-export-0","format":"png","scale":2.,"suffix":"@2x"}])),
+    ] {
+        for mixed in [false, true] {
+            let mut edited = baseline.clone();
+            let mut node = serde_json::to_value(&edited.nodes[id]).unwrap();
