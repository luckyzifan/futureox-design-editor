+    assert_eq!(next["key"], actual);
+    let again = f.call(&next, "large.commitCanvas", json!({"key":actual,"requestId":"json-after-rebind",
+        "json":serde_json::to_string(&document).unwrap()})).unwrap();
+    assert_eq!(again["key"], actual);
+}
