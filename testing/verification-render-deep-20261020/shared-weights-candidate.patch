diff --git a/frontend/design-client/src/kernel/gpu/image-bilinear-weights.ts b/frontend/design-client/src/kernel/gpu/image-bilinear-weights.ts
new file mode 100644
index 0000000..eed7a8c
--- /dev/null
+++ b/frontend/design-client/src/kernel/gpu/image-bilinear-weights.ts
@@ -0,0 +1,87 @@
+/** Exact WebGPU image-only specialization. Original scalar/vector samplers
+ * remain the fallback and the independently callable GPU reference. */
+export const imageBilinearWeightsWgsl = /* wgsl */`
+struct ImageBilinearWeightPlan {
+ w00:vec2<u32>,w10:vec2<u32>,w01:vec2<u32>,w11:vec2<u32>,
+ denominatorBits:u32,valid:u32,
+}
+fn imageBilinearWeightProduct(horizontal:u32,vertical:u32)->vec2<u32>{
+ if(horizontal==0u||vertical==0u){return vec2<u32>(0u);}
+ return bsMultiply(horizontal,vertical);
+}
+fn imageBilinearWeightPlan(k:vec2<f32>)->ImageBilinearWeightPlan{
+ var plan:ImageBilinearWeightPlan;
+ let x:vec2<u32>=bsFraction(bitcast<u32>(k.x));let y:vec2<u32>=bsFraction(bitcast<u32>(k.y));
+ if(x.y>31u||y.y>31u){return plan;}
+ let dx:u32=1u<<x.y;let dy:u32=1u<<y.y;
+ plan.w00=imageBilinearWeightProduct(dx-x.x,dy-y.x);
+ plan.w10=imageBilinearWeightProduct(x.x,dy-y.x);
+ plan.w01=imageBilinearWeightProduct(dx-x.x,y.x);
+ plan.w11=imageBilinearWeightProduct(x.x,y.x);
+ plan.denominatorBits=x.y+y.y;plan.valid=1u;return plan;
+}
+// This predicate only chooses an implementation. All channels which would
+// return early in bsBilinear still execute that original function, preserving
+// first-nonfinite neighbour priority and signed-zero canonicalization.
+fn imageBilinearNeedsWeights(p:vec4<f32>)->bool{
+ let raw:vec4<u32>=bitcast<vec4<u32>>(p);
+ let first:u32=select(raw[0u],0u,(raw[0u]&0x7fffffffu)==0u);var same:bool=true;
+ for(var i:u32=0u;i<4u;i=i+1u){
+  if((raw[i]&0x7fffffffu)>0x7f7fffffu){return false;}
+  let value:u32=select(raw[i],0u,(raw[i]&0x7fffffffu)==0u);same=same&&value==first;
+ }
+ return !same;
+}
+fn imageBilinearPositive(p:vec4<f32>,plan:ImageBilinearWeightPlan)->vec2<u32>{
+ if(plan.valid==0u){return vec2<u32>(0u);}
+ let raw:vec4<u32>=bitcast<vec4<u32>>(p);
+ var minimum:u32=255u;var maximum:u32=0u;
+ for(var i:u32=0u;i<4u;i=i+1u){
+  let exponent:u32=(raw[i]>>23u)&255u;if(exponent==255u){return vec2<u32>(0u);}
+  if((raw[i]&0x7fffffffu)!=0u){minimum=min(minimum,max(exponent,1u));maximum=max(maximum,max(exponent,1u));}
+ }
+ if(maximum==0u){return vec2<u32>(0u,1u);}
+ if(maximum-minimum>48u||maximum-minimum+plan.denominatorBits>102u){return vec2<u32>(0u);}
+ for(var j:u32=0u;j<4u;j=j+1u){bsCompact[j]=0u;}
+ for(var term:u32=0u;term<4u;term=term+1u){
+  let exponent:u32=(raw[term]>>23u)&255u;
+  let mantissa:u32=(raw[term]&0x7fffffu)|select(0u,0x800000u,exponent!=0u);
+  if(mantissa==0u){continue;}
+  var weight:vec2<u32>=plan.w00;
+  if(term==1u){weight=plan.w10;}else if(term==2u){weight=plan.w01;}else if(term==3u){weight=plan.w11;}
+  if(weight.x==0u&&weight.y==0u){continue;}
+  let low:vec2<u32>=bsMultiply(weight.x,mantissa);let high:vec2<u32>=bsMultiply(weight.y,mantissa);
+  let middle:u32=low.y+high.x;
+  let product:vec3<u32>=vec3<u32>(low.x,middle,high.y+select(0u,1u,middle<low.y));
+  let shift:u32=max(exponent,1u)-minimum;let negative:bool=(raw[term]>>31u)!=0u;
+  bsCompactAdd(product,shift,negative);
+ }
+ let bits:u32=bsCompactRound(i32(minimum)-150-i32(plan.denominatorBits));
+ return vec2<u32>(bits,select(0u,1u,(bits&0x7f800000u)!=0x7f800000u));
+}
+fn imageBilinearChannel(p:vec4<f32>,k:vec2<f32>,needed:bool,plan:ImageBilinearWeightPlan,wordLimit:u32,termCount:u32)->f32{
+ if(needed){let result:vec2<u32>=imageBilinearPositive(p,plan);if(result.y==1u){return bitcast<f32>(result.x);}}
+ // Keep the complete original bounded/windowed/19-limb sequence when the
+ // shared positive proof is unsupported. Never approximate or drop a term.
+ return bsBilinear(p,k.x,k.y,wordLimit,termCount);
+}
+fn imageBilinearWeights4(a:vec4<f32>,b:vec4<f32>,c:vec4<f32>,d:vec4<f32>,k:vec2<f32>,wordLimit:u32,termCount:u32)->vec4<f32>{
+ let ub:u32=bitcast<u32>(k.x);let vb:u32=bitcast<u32>(k.y);
+ let uabs:u32=ub&0x7fffffffu;let vabs:u32=vb&0x7fffffffu;
+ if(wordLimit!=19u||termCount!=9u||uabs>0x3f800000u||vabs>0x3f800000u||ub>0x80000000u||vb>0x80000000u||
+  ((uabs==0u||uabs==0x3f800000u)&&(vabs==0u||vabs==0x3f800000u))){
+  return bsBilinear4(a,b,c,d,k,wordLimit,termCount);
+ }
+ let red:vec4<f32>=vec4<f32>(a.x,b.x,c.x,d.x);let green:vec4<f32>=vec4<f32>(a.y,b.y,c.y,d.y);
+ let blue:vec4<f32>=vec4<f32>(a.z,b.z,c.z,d.z);let alpha:vec4<f32>=vec4<f32>(a.w,b.w,c.w,d.w);
+ let needed:vec4<bool>=vec4<bool>(imageBilinearNeedsWeights(red),imageBilinearNeedsWeights(green),imageBilinearNeedsWeights(blue),imageBilinearNeedsWeights(alpha));
+ if(!any(needed)){return bsBilinear4(a,b,c,d,k,wordLimit,termCount);}
+ let plan:ImageBilinearWeightPlan=imageBilinearWeightPlan(k);
+ if(plan.valid==0u){return bsBilinear4(a,b,c,d,k,wordLimit,termCount);}
+ return vec4<f32>(
+  imageBilinearChannel(red,k,needed.x,plan,wordLimit,termCount),
+  imageBilinearChannel(green,k,needed.y,plan,wordLimit,termCount),
+  imageBilinearChannel(blue,k,needed.z,plan,wordLimit,termCount),
+  imageBilinearChannel(alpha,k,needed.w,plan,wordLimit,termCount));
+}
+`
diff --git a/frontend/design-client/src/kernel/gpu/image-bilinear-weights.test.ts b/frontend/design-client/src/kernel/gpu/image-bilinear-weights.test.ts
new file mode 100644
index 0000000..23589ee
--- /dev/null
+++ b/frontend/design-client/src/kernel/gpu/image-bilinear-weights.test.ts
@@ -0,0 +1,201 @@
+import { readFileSync } from 'node:fs'
+import { expect, test } from 'vitest'
+import sampling from '../../../../../design-studio/crates/design-kernel/shaders/sampling.wgsl?raw'
+import corpus from '../../../../../testing/fixtures/design/sampling-vectors.json'
+import { roundFraction } from '../../../scripts/exact-prefix-division-vectors'
+import { imageBilinearWeightsWgsl } from './image-bilinear-weights'
+import { imageCoordinateSource } from './image-coordinate-source'
+import { displayArithmeticSource } from './display-arithmetic'
+
+type FloatBits={bits:number}
+type Vector<T>=T[]&{x:T;y:T;z:T;w:T}
+type WeightPlan={w00:Vector<number>;w10:Vector<number>;w01:Vector<number>;w11:Vector<number>;denominatorBits:number;valid:number}
+const vector=<T>(size:number,...values:T[]):Vector<T>=>{
+  const result=Array.from({length:size},(_,i)=>values.length===1?values[0]:values[i]) as Vector<T>
+  ;[result.x,result.y,result.z,result.w]=result
+  return result
+}
+const float=(bits:number):FloatBits=>({bits:bits>>>0})
+const numberBits=(value:number)=>{
+  const f=new Float32Array([value]);return new Uint32Array(f.buffer)[0]
+}
+const fraction=(bits:number)=>{
+  const raw=bits&0x7fffffff
+  if(raw===0)return {numerator:0n,power:0}
+  const exponent=(raw>>>23)&255
+  let numerator=BigInt((raw&0x7fffff)|(exponent===0?0:0x800000)),power=150-Math.max(exponent,1)
+  while((numerator&1n)===0n&&power>0){numerator>>=1n;power--}
+  return {numerator,power}
+}
+const invalidWeight=(bits:number)=>(bits&0x7fffffff)>0x3f800000||bits>0x80000000
+function scalarOracle(p:number[],u:number,v:number):number{
+  for(const bits of p)if((bits&0x7fffffff)>0x7f7fffff)return bits
+  const ub=u&0x7fffffff,vb=v&0x7fffffff
+  if(invalidWeight(u)||invalidWeight(v))return ((ub&0x7fffff)|0x7fc00000)>>>0
+  const normalized=p.map(bits=>(bits&0x7fffffff)===0?0:bits)
+  if(normalized.every(bits=>bits===normalized[0]))return normalized[0]
+  if((ub===0||ub===0x3f800000)&&(vb===0||vb===0x3f800000))
+    return normalized[Number(ub!==0)+2*Number(vb!==0)]
+  const x=fraction(u),y=fraction(v),dx=1n<<BigInt(x.power),dy=1n<<BigInt(y.power)
+  const weights=[(dx-x.numerator)*(dy-y.numerator),x.numerator*(dy-y.numerator),(dx-x.numerator)*y.numerator,x.numerator*y.numerator]
+  const parts=p.map(bits=>{
+    const exponent=(bits>>>23)&255,mantissa=BigInt((bits&0x7fffff)|(exponent===0?0:0x800000))
+    return {mantissa:bits>>>31?-mantissa:mantissa,quantum:Math.max(exponent,1)-150}
+  })
+  const quantum=Math.min(...parts.filter(part=>part.mantissa!==0n).map(part=>part.quantum))
+  let sum=0n
+  parts.forEach((part,i)=>{if(part.mantissa!==0n)sum+=(part.mantissa<<BigInt(part.quantum-quantum))*weights[i]})
+  return roundFraction(sum,1n<<BigInt(x.power+y.power),quantum)
+}
+function body(source:string,name:string){
+  const start=source.indexOf(`fn ${name}(`),open=source.indexOf('{',start)
+  if(start<0||open<start)throw Error(`Missing shader function ${name}`)
+  let end=open+1,depth=1
+  for(;depth&&end<source.length;end++){if(source[end]==='{')depth++;else if(source[end]==='}')depth--}
+  if(depth)throw Error(`Incomplete shader function ${name}`)
+  return {signature:source.slice(start,open),body:source.slice(open+1,end-1)}
+}
+function compileFunction(source:string,name:string){
+  const found=body(source,name),args=found.signature.slice(found.signature.indexOf('(')+1,found.signature.indexOf(')'))
+    .split(',').map(argument=>argument.split(':')[0]).join(',')
+  const translated=found.body
+    .replace(/\b(0x[0-9a-f]+|\d+)u\b/gi,'$1')
+    .replace(/var plan:ImageBilinearWeightPlan;/,'let plan=zeroPlan();')
+    .replace(/\b(let|var)\s+(\w+):u32=([^;]+);/g,'$1 $2=u32($3);')
+    .replace(/\b(let|var)\s+(\w+):(?:vec[234]<(?:u32|f32|bool)>|bool|ImageBilinearWeightPlan)=/g,'$1 $2=')
+    .replace(/\bvar\b/g,'let')
+    .replace(/bitcast<vec4<u32>>/g,'bits4')
+    .replace(/bitcast<u32>/g,'bits')
+    .replace(/bitcast<f32>/g,'float')
+    .replace(/vec2<u32>/g,'v2u').replace(/vec3<u32>/g,'v3u')
+    .replace(/vec4<f32>/g,'v4f').replace(/vec4<bool>/g,'v4b')
+  return `function ${name}(${args}){${translated}}`
+}
+function harness(){
+  const mask128=(1n<<128n)-1n,compact=[0,0,0,0]
+  const stats={fraction:0,scalarFallback:0,vectorFallback:0}
+  const readCompact=()=>compact.reduce((value,word,index)=>value|(BigInt(word)<<BigInt(index*32)),0n)
+  const reference=(p:Vector<FloatBits>,u:FloatBits,v:FloatBits)=>float(scalarOracle(p.map(value=>value.bits),u.bits,v.bits))
+  const bindings={
+    bits:(value:FloatBits)=>value.bits,
+    bits4:(value:Vector<FloatBits>)=>vector(4,...value.map(item=>item.bits)),
+    float,u32:(value:number)=>value>>>0,i32:(value:number)=>value|0,
+    min:Math.min,max:Math.max,select:<T>(a:T,b:T,condition:boolean)=>condition?b:a,
+    any:(values:boolean[])=>values.some(Boolean),
+    v2u:(...values:number[])=>vector(2,...values.map(value=>value>>>0)),
+    v3u:(...values:number[])=>vector(3,...values.map(value=>value>>>0)),
+    v4f:(...values:FloatBits[])=>vector(4,...values),
+    v4b:(...values:boolean[])=>vector(4,...values),
+    zeroPlan:()=>({w00:vector(2,0),w10:vector(2,0),w01:vector(2,0),w11:vector(2,0),denominatorBits:0,valid:0}),
+    bsMultiply:(a:number,b:number)=>{const product=BigInt(a>>>0)*BigInt(b>>>0);return vector(2,Number(product&0xffffffffn),Number(product>>32n))},
+    bsCompact:compact,
+    bsCompactAdd:(product:number[],shift:number,negative:boolean)=>{
+      const value=product.reduce((sum,word,index)=>sum|(BigInt(word)<<BigInt(index*32)),0n)<<BigInt(shift)
+      const sum=(readCompact()+(negative?-value:value))&mask128
+      for(let i=0;i<4;i++)compact[i]=Number((sum>>BigInt(i*32))&0xffffffffn)
+      return 0
+    },
+    bsCompactRound:(quantum:number)=>{const value=readCompact();return roundFraction(value&(1n<<127n)?value-(1n<<128n):value,1n,quantum)},
+    bsBilinear:(p:Vector<FloatBits>,u:FloatBits,v:FloatBits)=>{stats.scalarFallback++;return reference(p,u,v)},
+    bsBilinear4:(a:Vector<FloatBits>,b:Vector<FloatBits>,c:Vector<FloatBits>,d:Vector<FloatBits>,k:Vector<FloatBits>)=>{
+      stats.vectorFallback++;return vector(4,...[0,1,2,3].map(channel=>reference(vector(4,a[channel],b[channel],c[channel],d[channel]),k.x,k.y)))
+    },
+    recordFraction:()=>{stats.fraction++},
+  }
+  const names=['imageBilinearWeightProduct','imageBilinearWeightPlan','imageBilinearNeedsWeights','imageBilinearPositive','imageBilinearChannel','imageBilinearWeights4']
+  const functions=compileFunction(sampling,'bsFraction').replace('{','{recordFraction();')+'\n'+
+    names.map(name=>compileFunction(imageBilinearWeightsWgsl,name)).join('\n')
+  const execute=new Function(...Object.keys(bindings),`${functions};return {imageBilinearWeightPlan,imageBilinearWeights4}`)(...Object.values(bindings)) as {
+    imageBilinearWeightPlan(k:Vector<FloatBits>):WeightPlan
+    imageBilinearWeights4(a:Vector<FloatBits>,b:Vector<FloatBits>,c:Vector<FloatBits>,d:Vector<FloatBits>,k:Vector<FloatBits>,words:number,terms:number):Vector<FloatBits>
+  }
+  return {
+    stats,
+    plan:(k:number[])=>execute.imageBilinearWeightPlan(vector(2,...k.map(float))),
+    run:(corners:number[][],k:number[],words=19,terms=9)=>execute.imageBilinearWeights4(
+      vector(4,...corners[0].map(float)),vector(4,...corners[1].map(float)),
+      vector(4,...corners[2].map(float)),vector(4,...corners[3].map(float)),
+      vector(2,...k.map(float)),words,terms).map(value=>value.bits),
+  }
+}
+const corners=[[.1,.2,.3,.4],[.3,.4,.5,.6],[.5,.6,.7,.8],[.7,.8,.9,1]].map(row=>row.map(numberBits))
+const expected=(values:number[][],k:number[])=>[0,1,2,3].map(channel=>scalarOracle(values.map(row=>row[channel]),k[0],k[1]))
+
+test('production shared plans retain all 64-bit weights and their exact dyadic sum',()=>{
+  const values=[0,-0,1,.5,.25,.1,.75,2**-31,1-2**-24].map(numberBits)
+  for(const u of values)for(const v of values){
+    const plan=harness().plan([u,v]),x=fraction(u),y=fraction(v)
+    expect(plan.valid).toBe(1);expect(plan.denominatorBits).toBe(x.power+y.power)
+    const dx=1n<<BigInt(x.power),dy=1n<<BigInt(y.power)
+    const wanted=[(dx-x.numerator)*(dy-y.numerator),x.numerator*(dy-y.numerator),(dx-x.numerator)*y.numerator,x.numerator*y.numerator]
+    const actual=[plan.w00,plan.w10,plan.w01,plan.w11].map(weight=>BigInt(weight.x)|(BigInt(weight.y)<<32n))
+    expect(actual).toEqual(wanted)
+    expect(actual.reduce((sum,value)=>sum+value,0n)).toBe(1n<<BigInt(plan.denominatorBits))
+  }
+})
+test.each([numberBits(2**-32),1,numberBits(-.25),numberBits(1.01),0x7f800000,0xff800000,0x7fc01234])(
+  'unsupported fraction bits %i cannot create a shared plan',bits=>{
+    expect(harness().plan([bits,numberBits(.5)]).valid).toBe(0)
+    expect(harness().plan([numberBits(.5),bits]).valid).toBe(0)
+  },
+)
+test('four varying channels share two decompositions while retaining their individual exact reductions',()=>{
+  const h=harness(),k=[numberBits(.375),numberBits(.625)]
+  expect(h.run(corners,k)).toEqual(expected(corners,k))
+  expect(h.stats).toEqual({fraction:2,scalarFallback:0,vectorFallback:0})
+})
+test('constant alpha keeps its original scalar early return while RGB reuse the shared weights',()=>{
+  const h=harness(),values=corners.map(row=>[...row.slice(0,3),numberBits(1)]),k=[numberBits(.375),numberBits(.625)]
+  expect(h.run(values,k)).toEqual(expected(values,k))
+  expect(h.stats).toEqual({fraction:2,scalarFallback:1,vectorFallback:0})
+})
+test('constant RGBA and every signed-zero/unit corner bypass the shared plan entirely',()=>{
+  for(const k of [[0,0],[0x80000000,0],[0,numberBits(1)],[numberBits(1),0],[numberBits(1),numberBits(1)]]){
+    const h=harness();expect(h.run(corners,k)).toEqual(expected(corners,k));expect(h.stats.fraction).toBe(0)
+  }
+  const h=harness(),values=Array.from({length:4},()=>[numberBits(.25),0x80000000,0,numberBits(1)]),k=[numberBits(.2),numberBits(.7)]
+  expect(h.run(values,k)).toEqual(expected(values,k));expect(h.stats.fraction).toBe(0)
+})
+test('zero-weight nonfinite neighbours win per channel, including when the other channels use shared weights',()=>{
+  const h=harness(),values=corners.map(row=>[...row]),k=[0,numberBits(.5)]
+  values[1][0]=0x7fc01234;values[0][1]=0xff800000;values[3][1]=0x7fc05678
+  expect(h.run(values,k)).toEqual(expected(values,k))
+  expect(h.run(values,k)[0]).toBe(0x7fc01234)
+  expect(h.run(values,k)[1]).toBe(0xff800000)
+})
+test('invalid weights preserve original nonfinite priority and NaN payload selection',()=>{
+  const values=corners.map(row=>[...row]);values[1][0]=0x7fc01234;values[0][1]=0xff800000
+  for(const k of [[0x7fc05678,numberBits(.5)],[numberBits(.5),0x7fc05678],[numberBits(-.1),0]]){
+    const h=harness();expect(h.run(values,k)).toEqual(expected(values,k));expect(h.stats.fraction).toBe(0)
+  }
+})
+test('fine fractions, exponent-span boundaries and signed cancellation retain the original fallback result',()=>{
+  const pairs=[[numberBits(2**-32),numberBits(.5)],[1,numberBits(.5)],[numberBits(2**-31),numberBits(2**-31)]]
+  for(const span of [40,41,48,49]){
+    const values=corners.map((row,i)=>row.map((_,channel)=>((100+(i?span:0))<<23)|((i*13171+channel*101)&0x7fffff)|(i===2?0x80000000:0)).map(value=>value>>>0))
+    for(const k of pairs){const h=harness();expect(h.run(values,k)).toEqual(expected(values,k))}
+  }
+})
+test('independent sampling vectors remain bit-identical for replicated RGBA',()=>{
+  const h=harness()
+  for(const row of corpus.vectors.slice(0,256)){
+    const values=row.slice(0,4).map(bits=>[bits,bits,bits,bits]),k=row.slice(4,6)
+    expect(h.run(values,k)).toEqual([row[6],row[6],row[6],row[6]])
+  }
+})
+test('non-default program limits delegate to the original vector sampler',()=>{
+  for(const [words,terms] of [[18,9],[19,8]]){
+    const h=harness();h.run(corners,[numberBits(.25),numberBits(.75)],words,terms)
+    expect(h.stats).toEqual({fraction:0,scalarFallback:0,vectorFallback:1})
+  }
+})
+test('image adapter leaves shared sampling intact and display specialization still delegates to the original mix',()=>{
