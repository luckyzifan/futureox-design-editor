+/** Actual WebGPU oracle: unchanged bsBilinear4 and the image-only candidate
+ * receive identical RGBA neighbours and weights in the same invocation. */
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+import { imageBilinearWeightsWgsl } from '../src/kernel/gpu/image-bilinear-weights'
+import { roundFraction } from './exact-prefix-division-vectors'
+import { project, repository, runProof, shaderRoot, sha256 } from './exact-prefix-proof-utils'
+
+type Case={name:string;corners:number[][];weights:number[];expected:number[]}
+const corpusPaths=['sampling-vectors.json','bounded-sampling-vectors.json']
+  .map(name=>join(repository,'testing/fixtures/design',name))
+const bits=(value:number)=>new Uint32Array(new Float32Array([value]).buffer)[0]
+function fraction(value:number){
+  const raw=value&0x7fffffff
+  if(raw===0)return {numerator:0n,power:0}
+  const exponent=(raw>>>23)&255
+  let numerator=BigInt((raw&0x7fffff)|(exponent===0?0:0x800000)),power=150-Math.max(1,exponent)
+  while(power>0&&(numerator&1n)===0n){numerator>>=1n;power--}
+  return {numerator,power}
+}
+/** Independent signed rational value followed by one BigInt nearest-even
+ * rounding. Nonfinite/invalid-weight priority is the public sampler contract. */
+function expectedChannel(p:number[],u:number,v:number){
+  for(const value of p)if((value&0x7fffffff)>0x7f7fffff)return value
+  const ub=u&0x7fffffff,vb=v&0x7fffffff
+  if(ub>0x3f800000||vb>0x3f800000||u>0x80000000||v>0x80000000)return ((ub&0x7fffff)|0x7fc00000)>>>0
+  const normalized=p.map(value=>(value&0x7fffffff)===0?0:value)
+  if(normalized.every(value=>value===normalized[0]))return normalized[0]
+  if((ub===0||ub===0x3f800000)&&(vb===0||vb===0x3f800000))return normalized[Number(ub!==0)+2*Number(vb!==0)]
+  const x=fraction(u),y=fraction(v),dx=1n<<BigInt(x.power),dy=1n<<BigInt(y.power)
+  const weights=[(dx-x.numerator)*(dy-y.numerator),x.numerator*(dy-y.numerator),(dx-x.numerator)*y.numerator,x.numerator*y.numerator]
+  const parts=p.map(value=>{
+    const exponent=(value>>>23)&255,mantissa=BigInt((value&0x7fffff)|(exponent===0?0:0x800000))
+    return {mantissa:value>>>31?-mantissa:mantissa,quantum:Math.max(exponent,1)-150}
+  })
+  const quantum=Math.min(...parts.filter(value=>value.mantissa!==0n).map(value=>value.quantum))
+  let numerator=0n
+  parts.forEach((value,i)=>{if(value.mantissa!==0n)numerator+=(value.mantissa<<BigInt(value.quantum-quantum))*weights[i]})
+  return roundFraction(numerator,1n<<BigInt(x.power+y.power),quantum)
+}
+
+await runProof('forma-image-bilinear-weights',
+  [...corpusPaths,join(project,'scripts/exact-prefix-division-vectors.ts')],async proof=>{
+  const sampling=await readFile(join(shaderRoot,'sampling.wgsl'),'utf8')
+  const cases:Case[]=[],groups=new Map<string,number[][]>()
+  const counts={corpus:0,mixedCorpus:0,mixedBoundary:0}
+  for(const path of corpusPaths){
+    const corpus=JSON.parse(await readFile(path,'utf8')) as {vectors:number[][]}
+    for(const [index,row] of corpus.vectors.entries()){
+      cases.push({name:`${path.split('/').at(-1)}:${index}`,corners:row.slice(0,4).map(value=>[value,value,value,value]),
+        weights:row.slice(4,6),expected:[row[6],row[6],row[6],row[6]]})
+      counts.corpus++
+      const key=`${row[4]}:${row[5]}`,group=groups.get(key)||[]
+      if(group.length<4)group.push(row)
+      groups.set(key,group)
+    }
+  }
+  for(const [key,rows] of groups){
+    if(rows.length<2)continue
+    const channels=Array.from({length:4},(_,i)=>rows[i%rows.length])
+    cases.push({name:`mixed-independent-corpus:${key}`,
+      corners:Array.from({length:4},(_,corner)=>channels.map(row=>row[corner])),
+      weights:channels[0].slice(4,6),expected:channels.map(row=>row[6])})
+    counts.mixedCorpus++
+  }
+  const base=[[.1,.2,.3,1],[.3,.4,.5,1],[.5,.6,.7,1],[.7,.8,.9,1]].map(row=>row.map(bits))
+  const add=(name:string,corners:number[][],weights:number[])=>{
+    cases.push({name,corners,weights,expected:[0,1,2,3].map(channel=>expectedChannel(corners.map(row=>row[channel]),weights[0],weights[1]))})
+    counts.mixedBoundary++
+  }
+  for(const [index,weights] of [
+    [0,0],[0x80000000,0],[bits(1),0],[0,bits(1)],[bits(1),bits(1)],
+    [bits(.375),bits(.625)],[bits(2**-31),bits(2**-31)],[bits(2**-32),bits(.5)],[1,bits(.5)],
+    [0x7fc05678,bits(.5)],[bits(.5),0x7fc05678],[bits(-.1),0],[bits(1.01),bits(.5)],
+  ].entries()){
+    add(`opaque-alpha-${index}`,base,weights)
+    const mixed=base.map(row=>[...row])
+    mixed[1][0]=0x7fc01234;mixed[0][1]=0xff800000;mixed[3][1]=0x7fc05678
+    mixed[0][2]=0x80000000;mixed[1][2]=0;mixed[2][2]=0x80000001;mixed[3][2]=1
+    add(`nonfinite-zero-priority-${index}`,mixed,weights)
+  }
+  for(const span of [40,41,48,49]){
+    const corners=base.map((row,i)=>row.map((_,channel)=>(
+      ((100+(i?span:0))<<23)|((i*13171+channel*101)&0x7fffff)|(i===2?0x80000000:0))>>>0))
+    add(`combined-exponent-span-${span}`,corners,[bits(2**-31),bits(2**-31)])
+  }
+  const code=sampling+'\n'+imageBilinearWeightsWgsl+`
+@group(0) @binding(0) var<storage,read> imageInputs:array<u32>;
+@group(0) @binding(1) var<storage,read_write> imageOutputs:array<vec4<u32>>;
+fn imageInput4(at:u32)->vec4<f32>{
+ return bitcast<vec4<f32>>(vec4<u32>(imageInputs[at],imageInputs[at+1u],imageInputs[at+2u],imageInputs[at+3u]));
+}
+@compute @workgroup_size(64) fn checkImageWeights(@builtin(global_invocation_id) id:vec3<u32>){
+ if(id.x*2u>=arrayLength(&imageOutputs)){return;}
+ let at=id.x*20u;
+ let a=imageInput4(at);let b=imageInput4(at+4u);let c=imageInput4(at+8u);let d=imageInput4(at+12u);
+ let k=bitcast<vec2<f32>>(vec2<u32>(imageInputs[at+16u],imageInputs[at+17u]));
+ let words=imageInputs[at+18u];let terms=imageInputs[at+19u];
+ let reference=bsBilinear4(a,b,c,d,k,words,terms);
+ let candidate=imageBilinearWeights4(a,b,c,d,k,words,terms);
+ imageOutputs[id.x*2u]=bitcast<vec4<u32>>(reference);
+ imageOutputs[id.x*2u+1u]=bitcast<vec4<u32>>(candidate);
+}`
+  const prepared={cases:cases.length,counts,shaderSha256:sha256(code),fixtureSha256:sha256(JSON.stringify(cases)),
+    expectedSource:'Existing independent sampling corpora plus signed BigInt rational/RNE boundary expectations; original bsBilinear4 is unchanged.'}
+  await proof.write('vectors.json',cases)
+  if(proof.prepareOnly)return prepared
+  const result=await proof.browser(page=>page.evaluate(async({code,cases})=>{
+    const adapter=await navigator.gpu?.requestAdapter()
+    if(!adapter)throw Error('Actual WebGPU adapter required')
+    const device=await adapter.requestDevice(),errors:string[]=[]
+    device.addEventListener('uncapturederror',event=>errors.push(event.error.message))
+    try{
+      const module=device.createShaderModule({code})
+      const compilation=(await module.getCompilationInfo()).messages.filter(message=>message.type==='error')
+      if(compilation.length)throw Error(compilation.map(message=>`${message.lineNum}:${message.message}`).join('\n'))
+      const pipeline=await device.createComputePipelineAsync({layout:'auto',compute:{module,entryPoint:'checkImageWeights'}})
+      const data=new Uint32Array(cases.flatMap(value=>[...value.corners.flat(),...value.weights,19,9]))
+      const input=device.createBuffer({size:data.byteLength,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_DST})
+      device.queue.writeBuffer(input,0,data)
+      const size=cases.length*32
+      const output=device.createBuffer({size,usage:GPUBufferUsage.STORAGE|GPUBufferUsage.COPY_SRC})
+      const readback=device.createBuffer({size,usage:GPUBufferUsage.COPY_DST|GPUBufferUsage.MAP_READ})
+      const group=device.createBindGroup({layout:pipeline.getBindGroupLayout(0),entries:[
+        {binding:0,resource:{buffer:input}},{binding:1,resource:{buffer:output}},
+      ]})
+      const encoder=device.createCommandEncoder(),pass=encoder.beginComputePass()
+      pass.setPipeline(pipeline);pass.setBindGroup(0,group);pass.dispatchWorkgroups(Math.ceil(cases.length/64));pass.end()
+      encoder.copyBufferToBuffer(output,0,readback,0,size);device.queue.submit([encoder.finish()])
+      await readback.mapAsync(GPUMapMode.READ)
+      const words=new Uint32Array(readback.getMappedRange()),examples:unknown[]=[]
+      let referenceOracleMismatches=0,candidateOracleMismatches=0,candidateReferenceMismatches=0
+      for(let row=0;row<cases.length;row++){
+        const reference=Array.from(words.subarray(row*8,row*8+4)),candidate=Array.from(words.subarray(row*8+4,row*8+8)),expected=cases[row].expected
+        const referenceBad=reference.some((value,channel)=>value!==expected[channel]),candidateBad=candidate.some((value,channel)=>value!==expected[channel])
+        const mismatch=reference.some((value,channel)=>value!==candidate[channel])
+        if(referenceBad)referenceOracleMismatches++
+        if(candidateBad)candidateOracleMismatches++
+        if(mismatch)candidateReferenceMismatches++
+        if((referenceBad||candidateBad||mismatch)&&examples.length<16)examples.push({name:cases[row].name,reference,candidate,expected})
+      }
+      readback.unmap()
+      if(errors.length)throw Error(errors.join('\n'))
+      return {adapter:{vendor:adapter.info.vendor,architecture:adapter.info.architecture,description:adapter.info.description},
+        cases:cases.length,rgbaComponents:cases.length*4,referenceOracleMismatches,candidateOracleMismatches,candidateReferenceMismatches,examples}
+    }finally{device.destroy()}
+  },{code,cases}))
+  await proof.write('gpu-result.json',result)
+  if(result.referenceOracleMismatches||result.candidateOracleMismatches||result.candidateReferenceMismatches)
+    throw Error('Exact image bilinear shared weights differ from the original shader or independent expectations')
+  return {...prepared,...result}
+})
