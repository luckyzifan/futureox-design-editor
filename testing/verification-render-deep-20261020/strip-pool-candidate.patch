+import { afterEach, expect, test, vi } from 'vitest'
+import { stripScratchPlan, type StripScratchDemand } from './strip-scratch-plan'
+import { GpuRenderer } from './renderer'
+import type { Driver, Texture } from './types'
+
+afterEach(()=>vi.unstubAllEnvs())
+const MiB=1024*1024
+function texture(width:number,height:number,binary=false):Texture {
+  return {width,height,bytes:width*height*(binary?4:16),resource:{},...(binary?{binaryCoverage:true as const}:{})} as Texture
+}
+const demands=(height:number):StripScratchDemand[]=>[
+  {width:3484,height,count:2},{width:3484,height,count:1,binary:true},{width:1032,height,count:1},
+]
+function fixture() {
+  let completed=false
+  const live=new Set<Texture>(),destroyed:Texture[]=[],created:Texture[]=[]
+  const create=(w:number,h:number,binary=false)=>{const t=texture(w,h,binary);live.add(t);created.push(t);return t}
+  const driver={name:'webgpu',managed:true,scratchBytes:0,resourceEpoch:2,completedResourceEpoch:0,
+    create:(w:number,h:number)=>create(w,h),createBinaryCoverage:(w:number,h:number)=>create(w,h,true),
+    destroy(t:Texture){expect(completed).toBe(true);destroyed.push(t);live.delete(t)},
+    checkpoint:vi.fn(async()=>{completed=true}),
+  } as unknown as Driver
+  const renderer=new GpuRenderer(driver,true,false) as any;renderer.scene={}
+  return {renderer,driver,live,destroyed,created,complete(){completed=true}}
+}
+
+test('exact physical format, size and multiplicity determine missing bytes; aliases cannot count twice',()=>{
+  const a=texture(100,20),b=texture(100,20,true),free=new Map<string,Texture[]>([['100:20',[a,a]],['binary:100:20',[b]]])
+  const plan=stripScratchPlan(free,[{width:100,height:20,count:1},{width:100,height:20,count:2},{width:100,height:20,count:1,binary:true}])!
+  expect(plan).toEqual({totalBytes:104000,reusedBytes:40000,missingBytes:64000})
+  free.set('100:20',[texture(100,20,true),texture(100,19),{...a,scalarCoverage:true}])
+  expect(stripScratchPlan(free,[{width:100,height:20,count:1}])!.missingBytes).toBe(32000)
+  for(const width of [0,-1,.5,NaN,Infinity,8193])expect(stripScratchPlan(free,[{width,height:20,count:1}])).toBeUndefined()
+})
+
+test('warm full strips and different-height tails stay inside the same hard ledger without a maintenance fence',async()=>{
+  const f=fixture(),r=f.renderer;r.bytes=200*MiB
+  let first:Texture[]|undefined
+  for(const height of [58,58,58,58,30,58,30]){
+    await r.reclaimStripScratch(demands(height),true)
+    const allocated=[r.acquire({x:0,y:0,w:3484,h:height}),r.acquire({x:0,y:0,w:3484,h:height}),
+      r.acquire({x:0,y:0,w:3484,h:height},true),r.acquire({x:0,y:0,w:1032,h:height})]
+    if(height===58){if(first)expect(allocated.map((s:any)=>s.texture)).toEqual([first[1],first[0],first[2],first[3]]);first=allocated.map((s:any)=>s.texture)}
+    expect(r.workingBytes).toBeLessThanOrEqual(256*MiB)
+    r.release(...allocated)
+  }
+  expect(f.created).toHaveLength(8);expect(f.destroyed).toEqual([]);expect(f.driver.checkpoint).not.toHaveBeenCalled()
+  expect(r.memoryPolicy().stripPoolMaintenanceSkips).toBe(7)
+  expect(r.memoryPolicy().stripPoolMissingBytesHighWater).toBe(stripScratchPlan(new Map(),demands(58))!.missingBytes)
+  // Scope exit still uses the original completed-checkpoint retirement path.
+  await r.reclaimScratch();expect(f.driver.checkpoint).toHaveBeenCalledOnce();expect(f.destroyed).toHaveLength(8)
+})
+
+test('a tail that cannot fit requests positive-byte pressure and never destroys before completion',async()=>{
+  const f=fixture(),r=f.renderer;r.bytes=250*MiB
+  const old=texture(6144,512);r.free.set('6144:512',[old]);f.live.add(old)
+  let finish!:()=>void
+  f.driver.checkpoint=vi.fn(async()=>{await new Promise<void>(resolve=>{finish=resolve});f.complete()})
+  const pending=r.reclaimStripScratch([{width:2560,height:512,count:1}],true)
+  expect(f.driver.checkpoint).toHaveBeenCalledOnce();expect(f.destroyed).toEqual([]);expect(r.bytes).toBe(250*MiB)
+  finish();await pending
+  expect(f.destroyed).toEqual([old]);expect(r.workingBytes+20*MiB).toBeLessThanOrEqual(r.frameBudget)
+  expect(r.memoryPolicy().stripPoolMaintenanceSkips).toBe(0)
+})
+
+test('cold strips, unsupported policy, retired uploads and unpinned coordinates retain old reclamation',async()=>{
+  for(const kind of ['cold','disabled','webgl','unmanaged','retired-upload','retired-kernel','coordinate']){
+    const f=fixture(),r=f.renderer,original=vi.spyOn(r,'reclaimScratch').mockResolvedValue(undefined)
+    if(kind==='disabled')vi.stubEnv('VITE_DESIGN_REUSE_STRIP_POOL','0')
+    if(kind==='webgl')(f.driver as any).name='webgl2'
+    if(kind==='unmanaged')(f.driver as any).managed=false
+    if(kind==='retired-upload')r.retiredUploads.push(texture(1,1))
+    if(kind==='retired-kernel')r.retiredKernels.push({texture:texture(1,1),epoch:1})
+    if(kind==='coordinate')r.coordinateMaps.add(texture(1,1))
+    await r.reclaimStripScratch(demands(58),kind!=='cold')
+    expect(original).toHaveBeenCalledOnce();expect(r.memoryPolicy().stripPoolMaintenanceSkips).toBe(0);vi.unstubAllEnvs()
+  }
+})
+
+test('pinned whole-support coordinate fields remain alive and cancellation still precedes all work',async()=>{
+  const f=fixture(),r=f.renderer,field=texture(3484,2)
+  r.coordinateMaps.add(field);r.filterImageFields={pinned:new Set([field]),fields:new Map()}
+  await r.reclaimStripScratch(demands(58),true)
