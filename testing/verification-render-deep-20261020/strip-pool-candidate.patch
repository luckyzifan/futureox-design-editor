diff --git a/frontend/design-client/src/kernel/gpu/strip-scratch-plan.ts b/frontend/design-client/src/kernel/gpu/strip-scratch-plan.ts
new file mode 100644
--- /dev/null
+++ b/frontend/design-client/src/kernel/gpu/strip-scratch-plan.ts
@@ -0,0 +1,31 @@
+import type { Texture } from './types'
+
+export type StripScratchDemand = { width: number; height: number; count: number; binary?: boolean }
+/** Count only physical same-format/same-size free storage. Reusing it is
+ * queue-ordered; this is an allocation estimate, never a completion proof.
+ * Add demands sharing a key so one pooled texture cannot satisfy two slots. */
+export function stripScratchPlan(free: ReadonlyMap<string, readonly Texture[]>, demands: readonly StripScratchDemand[]) {
+  const slots = new Map<string, StripScratchDemand>()
+  for (const demand of demands) {
+    if (![demand.width, demand.height, demand.count].every(Number.isSafeInteger) ||
+        demand.width < 1 || demand.height < 1 || demand.width > 8192 || demand.height > 8192 ||
+        demand.count < 1 || demand.count > 8) return
+    const key = `${demand.binary ? 'binary:' : ''}${demand.width}:${demand.height}`
+    const old = slots.get(key)
+    slots.set(key, { ...demand, count: demand.count + (old?.count || 0) })
+  }
+  if (!slots.size || slots.size > 4) return
+  let missingBytes = 0, reusedBytes = 0, totalBytes = 0
+  for (const [key, demand] of slots) {
+    if (demand.count > 8) return
+    const bytes = demand.width * demand.height * (demand.binary ? 4 : 16)
+    const available = [...new Set(free.get(key) || [])].filter(texture =>
+      texture.width === demand.width && texture.height === demand.height && texture.bytes === bytes &&
+      !!texture.binaryCoverage === !!demand.binary && !texture.scalarCoverage)
+    const reused = Math.min(available.length, demand.count)
+    totalBytes += bytes * demand.count
+    reusedBytes += bytes * reused
+    missingBytes += bytes * (demand.count - reused)
+  }
+  return { missingBytes, reusedBytes, totalBytes }
+}
