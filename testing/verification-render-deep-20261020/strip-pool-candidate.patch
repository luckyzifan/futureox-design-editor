+  r.frameCurrent=()=>false
+  await expect(r.reclaimStripScratch(demands(58),true)).rejects.toThrow('PREVIEW_CANCELLED')
+  expect(r.memoryPolicy().stripPoolMaintenanceSkips).toBe(1)
+})
