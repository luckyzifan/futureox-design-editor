  "batches": [
    {
      "name": "CPU/GPU overlap",
      "implemented": [
        "独立 CPU 准备线程上最多一个提前编译任务；GPU 保持单编码器顺序",
        "请求代次检查、错误延迟到消费点、取消 drain；文档更新有序",
        "区分 CPU 工作时间、暴露等待和流水墙钟时间"
      ],
      "measurement": "双画板最后一批可见瓦片编译等待 35.7 -> 2.4 ms；18 次提前准备。该轮整批墙钟 343.7 -> 359.5 ms，未观察到稳定端到端下降，不能用等待下降冒充整体加速。"
    },
    {
      "name": "Repeated drawing and coordinate uploads",
      "implemented": [
        "驻留根贡献使用既有区域 blend 更新，保留原合成顺序",
        "图片、渐变字段和 LUT 通过完整参数键跨帧驻留，共用 32 MiB/64 条预算与 GPU 完成生命周期",
        "完整背景前缀缓存保留为 VITE_DESIGN_RETAIN_PREFIX=1 实验项，默认关闭"
      ],
      "measurement": "双画板累计 pass 像素中位 40150982 -> 38462874；总样本耗时中位 31.4 -> 30.7 ms，改善有限且可能受系统噪声影响。6 组参数缓存对照字节一致；4 组实际字段路径复用 4 个字段且再次上传为 0。",
      "rejectedOptimization": "前缀缓存试验减少像素，但增大驻留/复制成本。三画板样本总时长中位 29.9 -> 30.8 ms，未纳入默认路径。"
    },
    {
      "name": "Resident scene index",
      "implemented": [
        "编译场景复用 parents/root ownership/source identities/image references/effect capabilities",
        "经验证的纯平移继承同一索引；新编译场景另建索引",
        "不以哈希表遍历顺序决定 painter order"
      ],
      "boundary": "这是 JS 编译场景的派生索引，不是完整 Rust 节点 arena 迁移；Document.nodes 仍保留原格式。单独端到端收益尚未隔离测量。"
    },
    {
      "name": "Compiled packet reuse",
      "implemented": [
        "每个准备通道最多 32 MiB/128 项，单包最多 4 MiB",
        "使用完整编译输入键，不使用近似哈希证明等价",
        "独立持有包字节；load/patch 使缓存失效；异步过期结果不写回缓存"
      ],
      "measurement": {
        "compiledPacketBytes": 27012106,
