// Exact integer-tent filtering in bounded bands. Declaration/math preamble
// is generated by TexturePrefix; preserves the old exactFilterChannel fallback.
struct PrefixPair { sum:PrefixInt, moment:PrefixInt }
struct PrefixMetadata {
 accepted:atomic<u32>, declined:atomic<u32>, pixels:atomic<u32>, unused:atomic<u32>,
 lines:array<vec4<u32>>,
}
@group(1) @binding(0) var<storage,read_write> prefixes:array<PrefixPair>;
@group(1) @binding(1) var<storage,read_write> prefixMetadata:PrefixMetadata;
@group(1) @binding(2) var<storage,read_write> prefixResults:array<vec2<u32>>;
// Mode22 uniform contract: u48=(length,first,count,axis),
// u49=(channel,integer-original-radius,0,0). No other shader mode sees them.
fn prefixPixel(x:u32,line:u32)->vec2<i32>{
 if(u(48u).w<0.5){return vec2<i32>(i32(x),i32(line));}
 return vec2<i32>(i32(line),i32(x));
}
fn prefixDecline(line:u32,reason:u32){prefixMetadata.lines[line]=vec4<u32>(0u,0u,0u,reason);atomicAdd(&prefixMetadata.declined,1u);}
@compute @workgroup_size(64)
fn prefixScan(@builtin(global_invocation_id) id:vec3<u32>){
 let localLine=id.x;let length=u32(u(48u).x);let first=u32(u(48u).y);let count=u32(u(48u).z);let radius=u32(u(49u).y);
 if(localLine>=count){return;}
 if(length==0u||length>16384u||radius==0u||radius>512u){prefixDecline(localLine,1u);return;}
 var minimum=255u;var maximum=0u;let channel=u32(u(49u).x);
 for(var j=0u;j<length;j=j+1u){
  let bits=bitcast<u32>(textureLoad(sourceA,prefixPixel(j,first+localLine),0)[channel]);let exponent=(bits>>23u)&255u;
  if(exponent==255u){prefixDecline(localLine,2u);return;}
  if((bits&0x7fffffffu)!=0u){minimum=min(minimum,max(exponent,1u));maximum=max(maximum,max(exponent,1u));}
 }
 if(maximum==0u){minimum=1u;}else if(maximum-minimum>40u){prefixDecline(localLine,3u);return;}
 var sum=PrefixInt(0u);var moment=PrefixInt(0u);let base=localLine*(length+1u);
 prefixes[base]=PrefixPair(sum,moment);
 for(var j=0u;j<length;j=j+1u){
  let bits=bitcast<u32>(textureLoad(sourceA,prefixPixel(j,first+localLine),0)[channel]);
  let value=prefix_sample(bits,minimum);sum=prefix_add(sum,value);moment=prefix_add(moment,prefix_mul_u32(value,j));
  prefixes[base+j+1u]=PrefixPair(sum,moment);
 }
 prefixMetadata.lines[localLine]=vec4<u32>(minimum,maximum,1u,0u);
 atomicAdd(&prefixMetadata.accepted,1u);atomicAdd(&prefixMetadata.pixels,length);
}
fn prefixPairAt(base:u32,index:u32)->PrefixPair{return prefixes[base+index];}
fn prefixValueAt(base:u32,index:u32)->PrefixInt{return prefix_sub(prefixPairAt(base,index+1u).sum,prefixPairAt(base,index).sum);}
@compute @workgroup_size(64)
fn prefixSolve(@builtin(global_invocation_id) id:vec3<u32>){
 let length=u32(u(48u).x);let count=u32(u(48u).z);let radius=u32(u(49u).y);let x=id.x;let localLine=id.y;
 if(localLine>=count||x>=length){return;}let resultIndex=localLine*length+x;
 prefixResults[resultIndex]=vec2<u32>(0u);let lineInfo=prefixMetadata.lines[localLine];if(lineInfo.z==0u){return;}
 let base=localLine*(length+1u);let left=u32(max(0,i32(x)-i32(radius)+1));let right=min(length,x+radius);
 let before=prefixPairAt(base,left);let center=prefixPairAt(base,x+1u);let after=prefixPairAt(base,right);
 let a=prefix_mul_i32(prefix_sub(center.sum,before.sum),i32(radius)-i32(x));
 let b=prefix_mul_i32(prefix_sub(after.sum,center.sum),i32(radius)+i32(x));
 let triangle=prefix_add(prefix_add(a,prefix_sub(center.moment,before.moment)),prefix_sub(b,prefix_sub(after.moment,center.moment)));
 var numerator=prefix_sub(prefix_mul_u32(triangle,6u),prefix_mul_u32(prefixValueAt(base,x),2u));
 if(x>=radius){numerator=prefix_add(numerator,prefixValueAt(base,x-radius));}
 if(x+radius<length){numerator=prefix_add(numerator,prefixValueAt(base,x+radius));}
 prefixResults[resultIndex]=prefix_round_ratio(numerator,6u*radius*radius,i32(lineInfo.x)-150);
}
override PREFIX_CHANNEL:u32=0u;
@fragment fn prefixResolve(@builtin(position) position:vec4<f32>)->@location(0) vec4<f32>{
 let pixel=vec2<u32>(floor(position.xy));let axis=u(48u).w;
 let x=select(pixel.y,pixel.x,axis<0.5);let localLine=select(pixel.x,pixel.y,axis<0.5)-u32(u(48u).y);
 let value=prefixResults[localLine*u32(u(48u).x)+x];
 if(prefixMetadata.lines[localLine].z!=0u&&value.y!=0u){return vec4<f32>(bitcast<f32>(value.x));}
 let p=position.xy+u(0u).xy;let direction=select(vec2<f32>(0.0,1.0),vec2<f32>(1.0,0.0),axis<0.5);
 return vec4<f32>(exactFilterChannel(p,direction,PREFIX_CHANNEL));
}
