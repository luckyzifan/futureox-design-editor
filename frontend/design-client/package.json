{
  "name": "@futureox/desktop-renderer",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run build:kernel && tsc --noEmit && vite build",
    "build:kernel": "python3 ../../design-studio/scripts/build-web.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:render-diagnostics": "node --import ./scripts/node-ts-local-resolver.mjs --test src/kernel/render-diagnostics.test.mjs scripts/node-ts-local-resolver.test.mjs",
    "test:render-contracts": "node --import ./scripts/node-ts-local-resolver.mjs --test src/image-import.test.mjs src/kernel/canvas-effect-sampling.test.mjs src/kernel/render-diagnostics.test.mjs src/kernel/cpu-frame-contract.test.mjs src/kernel/use-zoom-activity.test.mjs src/retained-board-capture.test.mjs scripts/node-ts-local-resolver.test.mjs",
    "test:node-entries": "node --import ./scripts/node-ts-local-resolver.mjs --test src/import-ownership.test.mjs src/kernel/op-sync-history.test.mjs src/shift-move-snapping.test.mjs src/kernel/render-failure-budget-fields.test.mjs src/kernel/render-failure-origin.test.mjs src/export-ownership.test.mjs src/model-feature-admission.test.mjs src/model-mask-admission.test.mjs src/sketch-text-query.test.mjs",
    "benchmark": "bun scripts/benchmark.ts",
    "lint": "biome lint src",
    "test:desktop-lifecycle": "bun scripts/check-desktop-lifecycle.ts",
    "test:canvas-motion": "bun scripts/check-canvas-motion.ts",
    "test:hdr-memory": "bun scripts/check-hdr-memory.ts",
    "test:mip-tiles": "bun scripts/check-mip-tiles.ts",
    "test:preview-materials": "bun scripts/check-preview-materials.ts",
    "test:editor-flows": "bun scripts/check-editor-flows.ts",
    "test:workspace-ui": "bun scripts/check-workspace-ui.ts",
    "test:sketch-local": "bun scripts/check-sketch-local.ts",
    "test:sketch-edit": "bun scripts/check-sketch-edit.ts",
    "test:sketch-performance": "bun scripts/check-sketch-performance.ts",
    "test:lod-lifecycle": "bun scripts/check-lod-lifecycle.ts",
    "test:local-workspace": "bun scripts/check-local-workspace.ts",
    "test:canvas-tools": "bun scripts/check-canvas-tools.ts",
    "test:canvas-utility-tools": "bun scripts/check-canvas-utility-tools.ts",
    "test:canvas-fallback": "bun scripts/check-canvas-fallback.ts",
    "test:canvas-selection": "bun scripts/check-canvas-selection.ts",
    "test:canvas-pointer-release": "bun scripts/check-canvas-pointer-release.ts",
    "test:panels": "bun scripts/check-panels.ts",
    "test:io-import": "bun scripts/check-io-import.ts",
    "test:preview-contract": "bun scripts/check-preview-contract.ts",
    "test:toolbar-menu": "bun scripts/check-toolbar-menu.ts",
    "test:sketch-toolbar-hits": "bun scripts/check-sketch-toolbar-hits.ts",
    "test:sketch-toolbar-hits-electron": "bun scripts/check-sketch-toolbar-hits-electron.ts",
    "test:scale-tools": "bun scripts/check-scale-tools.ts",
    "test:property-layout": "bun scripts/check-property-layout.ts",
    "test:pending-input": "bun scripts/check-pending-input.ts",
    "test:figma-software": "bun scripts/check-figma-software.ts",
    "test:tile-frame": "bun scripts/check-tile-frame.ts",
    "test:kernel-adapters": "bun scripts/check-kernel-adapters.ts",
    "test:bake-session": "bun scripts/check-bake-session.ts",
    "test:kernel-live": "bun scripts/check-kernel-live.ts",
    "test:graph-history": "bun test src/kernel/op-sync-history.test.mjs",
    "test:render-alignment": "bun scripts/check-render-alignment.ts",
    "test:renderer-contracts": "node --test src/kernel/gpu/renderer-regressions.test.mjs src/kernel/gpu/sample-effect-lifetime.test.mjs"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "fzstd": "0.1.1",
    "immer": "11.1.21",
    "kiwi-schema": "0.5.0",
    "lucide-react": "1.47.0",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "svg-pathdata": "9.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.1.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@webgpu/types": "^0.1.74",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.1"
  }
}
