# Build artifacts
**/target/
**/node_modules/
**/dist/
**/release/
**/test-results/
**/playwright-report/

# Keep local verification dumps out of Git. These paths admit maintained
# documentation and dedicated regression inputs alongside existing fixtures.
/testing/*
!/testing/README.md
!/testing/.gitignore
!/testing/automation-sqlite-benchmark.py
!/testing/fixture-policy.test.mjs
!/testing/generate-multifont-fixtures.py
!/testing/fixtures/
!/testing/lib/
.zcode/
.grok-bot-shots/
*.mac-local.*
/evidence/
/futureoxdesgin/
/frontend/design-client/verification/

# Generated kernel outputs (rebuilt via design-client `build:kernel`)
/frontend/design-client/public/kernel/
/frontend/design-client/src/generated/

# Python
**/__pycache__/
**/*.pyc

# Runtime
**/*.log
**/*.pid
.DS_Store

# Credentials and private configuration
**/.env
**/.env.*
!**/.env.example
!**/.env.template
!**/.env.*.example
!**/.env.*.template
**/secrets/
**/credentials.json
**/credentials.local.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
